# Copie para .env (não commitado) e ajuste os valores.

# Senha do usuário "admin" do Fuseki. Usada tanto pelo docker-compose (para
# configurar o Fuseki) quanto pelo shacl_pipeline.py (para autenticar o
# SPARQL Update HTTP contra o dataset "lab").
FUSEKI_ADMIN_PASSWORD=troque-esta-senha

# Endpoint base do Fuseki para o dataset lab. Default local do
# docker-compose.yml (porta 3033, dataset "lab"). 127.0.0.1, não localhost
# — ver config.py e docs/known-issues.md.
FUSEKI_URL=http://127.0.0.1:3033/lab
