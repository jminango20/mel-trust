# Fixture de cobertura: mel nativo com umidade que dispara SÓ a shape
# :HoneyNativeMoistureShape na severidade sh:Info (nunca sh:Violation),
# testando que allow_infos=True realmente segura um sh:Info sem derrubar
# conforms — cobertura que faltava porque sample-instance.ttl usa 23.0
# (fronteira exata que não dispara nem Info nem Warning).
#
# Por que 30.0: property shape 1 de :HoneyNativeMoistureShape tem
# sh:maxInclusive 23.0 / sh:Info -> 30.0 > 23.0 viola essa property shape,
# gera 1 resultado sh:Info. property shape 2 tem sh:minInclusive 23.0 e
# sh:maxInclusive 35.0 / sh:Warning -> 30.0 está dentro de [23.0, 35.0],
# satisfaz a constraint, NÃO gera resultado. Logo só a Info dispara.
#
# Acidez mantida em 45.0 (<= 80.0, limite de :HoneyNativeAcidityShape,
# também sh:Info) para não gerar um segundo resultado. Licença ambiental do
# Meliponário presente para não disparar :MeliponaryLicenseShape
# (sh:Violation) e derrubar conforms por outro motivo.
@prefix : <https://w3id.org/agrisemantics/AGRITRUST/bee-extension#> .
@prefix agritrust: <https://w3id.org/agrisemantics/AGRITRUST#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .

:CooperativaMelDoCerrado
    a agritrust:PlatformProvider, agritrust:DataConsumer ;
    rdfs:label "Cooperativa Mel do Cerrado"@pt ;
    agritrust:hasDID "did:web:coop-b.example" ;
    rdfs:comment "Provedora de plataforma TaaS para apicultores/meliponicultores associados. Registro SIE-DF-001."@pt .

:Apicultor_Joao_Cerrado
    a agritrust:DataProducer ;
    rdfs:label "João da Silva"@pt ;
    foaf:name "João da Silva" ;
    agritrust:hasDID "did:key:z6Mkkc7de5XEc1sUGBYxHo8yLWM9yTsnorqCNK7HnE8SZnVT" ;
    :hasSupplierCadaster "SIE-DF-0123 - Meliponário Jataí do Cerrado (12 colmeias de Tetragonisca angustula)" .

:Meliponario_Jatai_Cerrado
    a :Meliponary ;
    rdfs:label "Meliponário Jataí do Cerrado"@pt ;
    agritrust:ownedBy :Apicultor_Joao_Cerrado ;
    agritrust:hasIdentifier "MEL-DF-001" ;
    :hasEnvironmentalLicense :Licenca_Ambiental_Meliponario_Cerrado .

:Licenca_Ambiental_Meliponario_Cerrado
    a :EnvironmentalLicense ;
    rdfs:label "Licença Ambiental - Meliponário Jataí do Cerrado"@pt ;
    :environmentalLicenseNumber "IBRAM-LA-2026-0456" .

:Lote_Mel_Jatai_2026_008
    a :HoneyNativeStinglessBee ;
    agritrust:ownedBy :Apicultor_Joao_Cerrado ;
    :hasMoistureContent "30.0"^^xsd:decimal ;
    :hasHMFContent "9.0"^^xsd:decimal ;
    :hasAcidity "45.0"^^xsd:decimal ;
    agritrust:productionDate "2026-04-19"^^xsd:date ;
    agritrust:batchNumber "MN-2026-008" ;
    agritrust:qualityStatus "Umidade elevada dentro do limite de aproveitamento condicional (Portaria 1.439/2025)"@pt ;
    agritrust:legalStatus "Aprovado para Comercialização (Portaria 795/2023, Art. 46, II)"@pt ;
    :destinationCategory "Aproveitamento Condicional"@pt ;
    rdfs:comment "Espécie: Tetragonisca angustula (Jataí). Fixture de cobertura sh:Info (umidade 30.0)."@pt ;
    rdfs:label "Lote de Mel de Jataí - Meliponário Cerrado - Safra 2026/04 (fixture Info)"@pt .
