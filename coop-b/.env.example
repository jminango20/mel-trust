# Copie para .env (não commitado) e ajuste os valores.

# Senha do usuário "admin" do Fuseki. Usada tanto pelo docker-compose (para
# configurar o Fuseki) quanto pelo pipeline.py (para autenticar o SPARQL
# Update HTTP contra o dataset "coop-b").
FUSEKI_ADMIN_PASSWORD=troque-esta-senha

# Endpoint base do Fuseki para o dataset coop-b. Default local do
# docker-compose.yml (porta 3031, dataset "coop-b").
FUSEKI_URL=http://127.0.0.1:3031/coop-b
