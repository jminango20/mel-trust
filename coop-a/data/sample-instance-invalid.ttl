# Mesma estrutura de sample-instance.ttl, mas com umidade (24.5%) acima do
# limite de 20% definido em :HoneyApisMoistureShape (validation-shapes.ttl,
# IN 11/2000) e HMF (75.0 mg/kg) acima do limite de 60 mg/kg
# (:HMFValidationShape). Usado só para testar a rejeição do pipeline
# (conforms=False) — não é inserido no Fuseki.
@prefix : <https://w3id.org/agrisemantics/AGRITRUST/bee-extension#> .
@prefix agritrust: <https://w3id.org/agrisemantics/AGRITRUST#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

:Lote_Mel_ForaPadrao_2026_099
    a :HoneyApis ;
    agritrust:ownedBy :Apicultor_Joao_Cerrado ;
    :hasFloralOrigin "Silvestre"@pt ;
    :hasMoistureContent "24.5"^^xsd:decimal ;
    :hasHMFContent "75.0"^^xsd:decimal ;
    :hasAcidity "32.1"^^xsd:decimal ;
    :hasDiastaseActivity "10.5"^^xsd:decimal ;
    agritrust:productionDate "2026-04-20"^^xsd:date ;
    agritrust:batchNumber "MS-2026-099" ;
    rdfs:label "Lote de Mel Fora do Padrão - teste de rejeição"@pt .
