@prefix : <https://w3id.org/agrisemantics/AGRITRUST/bee-extension#> .
@prefix agritrust: <https://w3id.org/agrisemantics/AGRITRUST#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix sosa: <http://www.w3.org/ns/sosa/> .
@prefix geo: <http://www.opengis.net/ont/geosparql#> .
@prefix odrl: <http://www.w3.org/ns/odrl/2/> .
@prefix vc: <https://www.w3.org/2018/credentials/v1> .
@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix qudt: <http://qudt.org/vocab/unit/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

# =============================================================================
#  REGRAS SHACL PARA VALIDAÇÃO DE DADOS (Controle de Qualidade)
#=============================================================================

# [SHACL] Validação de Umidade para Mel de Apis (IN 11/2000)
:HoneyApisMoistureShape a sh:NodeShape ;
    sh:targetClass :HoneyApis ;
    sh:property [
        sh:path :hasMoistureContent ;
        sh:maxInclusive "20.0"^^xsd:decimal ;
        sh:severity sh:Violation ;
        sh:message "Umidade acima de 20% para mel de Apis mellifera (IN 11/2000)"@pt
    ] .

# [SHACL] Validação de HMF para Mel de Apis
:HMFValidationShape a sh:NodeShape ;
    sh:targetClass :HoneyApis ;
    sh:property [
        sh:path :hasHMFContent ;
        sh:maxInclusive "60.0"^^xsd:decimal ;
        sh:severity sh:Violation ;
        sh:message "HMF acima de 60 mg/kg - possível superaquecimento (IN 11/2000)"@pt
    ] .

# [SHACL] Validação de Acidez para Mel de Apis
:AcidityValidationShape a sh:NodeShape ;
    sh:targetClass :HoneyApis ;
    sh:property [
        sh:path :hasAcidity ;
        sh:maxInclusive "50.0"^^xsd:decimal ;
        sh:severity sh:Violation ;
        sh:message "Acidez acima de 50 meq/kg (IN 11/2000)"@pt
    ] .

# [SHACL] Validação de Diástase para Mel de Apis
:DiastaseValidationShape a sh:NodeShape ;
    sh:targetClass :HoneyApis ;
    sh:property [
        sh:path :hasDiastaseActivity ;
        sh:minInclusive "8.0"^^xsd:decimal ;
        sh:severity sh:Violation ;
        sh:message "Atividade diastásica abaixo de 8 Gothe (IN 11/2000)"@pt
    ] .

# [SHACL] Cardinalidade mínima de identificação/procedência para Mel de Apis
# — adicionada pelo MVP, com autorização do Ivan Bergier ("a ontologia é
# aberta e adaptável, artefatos semânticos novos podem ser adicionados",
# ver docs/respostas-ivan.md, pergunta 5). Antes desta shape, nenhuma regra
# do arquivo exigia batchNumber/ownedBy — descoberto ao construir POST /lote
# (coop-a/lote_endpoint.py), ver docs/known-issues.md ("POST /lote: gate
# SHACL, na prática, sempre passa").
:HoneyApisIdentificationShape a sh:NodeShape ;
    sh:targetClass :HoneyApis ;
    sh:property [
        sh:path agritrust:batchNumber ;
        sh:minCount 1 ;
        sh:severity sh:Violation ;
        sh:message "Lote precisa ter número de identificação"@pt
    ] ;
    sh:property [
        sh:path agritrust:ownedBy ;
        sh:minCount 1 ;
        sh:severity sh:Violation ;
        sh:message "Lote precisa ter produtor associado"@pt
    ] .

# [SHACL] Formato de geo:asWKT — adicionada pelo MVP, com autorização do
# Ivan Bergier ("a ontologia é aberta e adaptável, artefatos semânticos
# novos podem ser adicionados", ver docs/respostas-ivan.md, pergunta 5).
# Exige o formato "POINT(lon lat)" (convenção já usada em todo o projeto —
# ver coop-a/data/sample-instance.ttl, ontology/instances.ttl): a palavra
# POINT, dois números (sinal e parte decimal opcionais) separados por
# espaço, entre parênteses. sh:pattern (não sh:datatype): o valor já é
# tipado como geo:wktLiteral no dado real; o que faltava validar era o
# FORMATO da string WKT em si, que sh:datatype não cobre.
:GeoPointWKTShape a sh:NodeShape ;
    sh:targetClass geo:Point ;
    sh:property [
        sh:path geo:asWKT ;
        sh:pattern "^POINT\\s*\\(\\s*-?\\d+(\\.\\d+)?\\s+-?\\d+(\\.\\d+)?\\s*\\)$" ;
        sh:severity sh:Violation ;
        sh:message "geo:asWKT deve seguir o formato POINT(lon lat)"@pt
    ] .

# [SHACL] Cardinalidade mínima de um certificado válido (issuer, subject,
# data de emissão) — adicionada com autorização do Ivan Bergier: ontologia
# aberta a extensão, mesma base usada para HoneyApisIdentificationShape/
# GeoPointWKTShape (minCount/geo). `agritrust:Certificate` já é o termo
# usado no vocabulário (ver ontology/instances.ttl, `:Certificado_Organico_Apiario`/
# `:Certificado_Analise_Nativa`, e ontology/bee-extension.ttl,
# subclasses de `agritrust:Certificate`) — não é um termo novo. Predicados
# (`vc:issuer`/`vc:credentialSubject`/`vc:issuanceDate`) também já em uso
# nas mesmas instâncias, vocabulário W3C VC (`vc:` já declarado no topo
# deste arquivo).
#
# NÃO implementada em código ainda (nenhum endpoint monta um recurso
# `agritrust:Certificate` hoje — `certifier/credential_endpoint.py` emite
# a VC como SD-JWT, não como instância RDF persistida). Disponível para
# uso futuro, quando M5.5 modelar `certificateType`/`certificateNumber`/
# `analysisActivity` via PROV-O (ver
# docs/notas-arquitetura/certifier-claims-hardcoded-m4.md) — shape nova
# não afeta nenhum cenário existente, já que nada a referencia ativamente.
:CertificateShape a sh:NodeShape ;
    sh:targetClass agritrust:Certificate ;
    sh:property [
        sh:path vc:issuer ;
        sh:minCount 1 ;
        sh:severity sh:Violation ;
        sh:message "Certificado precisa ter emissor (issuer)"@pt
    ] ;
    sh:property [
        sh:path vc:credentialSubject ;
        sh:minCount 1 ;
        sh:severity sh:Violation ;
        sh:message "Certificado precisa referenciar o lote (credentialSubject)"@pt
    ] ;
    sh:property [
        sh:path vc:issuanceDate ;
        sh:minCount 1 ;
        sh:severity sh:Violation ;
        sh:message "Certificado precisa ter data de emissão (issuanceDate)"@pt
    ] .

# [SHACL] Aviso para Umidade em Mel Nativo (Portaria 1.439/2025)
:HoneyNativeMoistureShape a sh:NodeShape ;
    sh:targetClass :HoneyNativeStinglessBee ;
    sh:property [
        sh:path :hasMoistureContent ;
        sh:maxInclusive "23.0"^^xsd:decimal ;
        sh:severity sh:Info ;
        # Correção de redação (confirmada pelo Ivan): sh:maxInclusive só
        # gera um resultado SHACL quando o valor EXCEDE o limite — ou
        # seja, este sh:Info dispara para umidade ACIMA de 23%, nunca
        # "dentro" dele. Mensagem original dizia o oposto do que a
        # constraint realmente detecta.
        sh:message "Umidade acima de 23% - fora do padrão de aproveitamento direto, mas dentro da faixa de aproveitamento condicional (Portaria 1.439/2025)"@pt
    ] ;
    sh:property [
        sh:path :hasMoistureContent ;
        sh:minInclusive "23.0"^^xsd:decimal ;
        sh:maxInclusive "35.0"^^xsd:decimal ;
        sh:severity sh:Warning ;
        sh:message "Umidade elevada - verificar necessidade de desumidificação (Art. 2º, XIV da Portaria 1.439/2025)"@pt
    ] .

# [SHACL] Aviso para Acidez em Mel Nativo (Portaria 1.439/2025)
:HoneyNativeAcidityShape a sh:NodeShape ;
    sh:targetClass :HoneyNativeStinglessBee ;
    sh:property [
        sh:path :hasAcidity ;
        sh:maxInclusive "80.0"^^xsd:decimal ;
        sh:severity sh:Info ;
        sh:message "Acidez dentro do limite para destinação industrial (Portaria 1.439/2025)"@pt
    ] .

# [SHACL] Validação de Tamanho de Malha para Filtração (Art. 34, III da Portaria 795/2023)
:FiltrationMeshShape a sh:NodeShape ;
    sh:targetClass :Filtration ;
    sh:property [
        sh:path :hasMeshSize ;
        sh:minInclusive "40"^^xsd:integer ;
        sh:maxInclusive "80"^^xsd:integer ;
        sh:severity sh:Violation ;
        sh:message "Tamanho da malha deve estar entre 40 e 80 mesh (Art. 34, III da Portaria 795/2023)"@pt
    ] .

# [SHACL] Validação de GTA para Migração (Legislação de Defesa Sanitária)
:HiveMigrationGTAShape a sh:NodeShape ;
    sh:targetClass :HiveMigration ;
    sh:property [
        sh:path :hasGTA ;
        sh:minCount 1 ;
        sh:severity sh:Violation ;
        sh:message "Migração de colmeias requer GTA (Guia de Trânsito Animal) válida"@pt
    ] .

# [SHACL] Validação de Licença Ambiental para Meliponário (Art. 68 da Portaria 795/2023)
:MeliponaryLicenseShape a sh:NodeShape ;
    sh:targetClass :Meliponary ;
    sh:property [
        sh:path :hasEnvironmentalLicense ;
        sh:minCount 1 ;
        sh:severity sh:Violation ;
        sh:message "Meliponário requer licença ou autorização ambiental (Art. 68 da Portaria 795/2023)"@pt
    ] .

# [SHACL] Validação de Contrato de Dados
:DataContractShape a sh:NodeShape ;
    sh:targetClass agritrust:DataContract ;
    sh:property [
        sh:path agritrust:validFrom ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
        sh:message "Contrato de dados deve ter data de início"@pt
    ] ;
    sh:property [
        sh:path agritrust:validUntil ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
        sh:message "Contrato de dados deve ter data de término"@pt
    ] ;
    sh:property [
        sh:path agritrust:hasPolicyAssignee ;
        sh:minCount 1 ;
        sh:severity sh:Violation ;
        sh:message "Contrato de dados deve ter pelo menos um assignee"@pt
    ] .