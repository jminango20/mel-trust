#           CONTRATOS DE DADOS (ODRL) - Governança Automatizada
# =============================================================================

:DataContract_Exportacao_Silvestre_EU
    a agritrust:DataContract ;
    agritrust:contractId "CONTRACT-HONEY-EU-2026-042" ;
    rdfs:label "Contrato de Dados - Exportação Mel Silvestre para UE"@pt ;
    agritrust:validFrom "2026-04-15T00:00:00Z"^^xsd:dateTime ;
    agritrust:validUntil "2027-04-15T00:00:00Z"^^xsd:dateTime ;
    :priceUnits 2500000 ;  # ilustrativo: 2,50 USDT de teste (6 casas); valores de exemplo do mel-trust, não definidos pelo Ivan
    agritrust:purpose "Compliance EUDR e Certificação Orgânica para Importação Europeia"@pt ;
    agritrust:hasPolicyAssignee :Importador_Alemao_Mel ;
    agritrust:coversAsset :Lote_Mel_Silvestre_2026_042 ;
    agritrust:coversObservation :Observacao_Geolocalizacao_Apiario, :Observacao_Quantidade_Silvestre ;
    agritrust:hasODRLPolicy :Politica_Acesso_EUDR_Silvestre .

:Politica_Acesso_EUDR_Silvestre
    a odrl:Set ;
    odrl:permission [
        a odrl:Permission ;
        odrl:action odrl:read ;
        odrl:target :Lote_Mel_Silvestre_2026_042, :Observacao_Geolocalizacao_Apiario, :Observacao_Quantidade_Silvestre ;
        odrl:assignee :Importador_Alemao_Mel ;
        odrl:constraint [
            a odrl:Constraint ;
            odrl:leftOperand odrl:purpose ;
            odrl:operator odrl:eq ;
            odrl:rightOperand "Compliance EUDR"@en
        ]
    ] ;
    odrl:prohibition [
        a odrl:Prohibition ;
        odrl:action odrl:distribute ;
        odrl:target :Lote_Mel_Silvestre_2026_042 ;
        odrl:assignee :Importador_Alemao_Mel
    ] ;
    odrl:prohibition [
        a odrl:Prohibition ;
        odrl:action odrl:commercialize ;
        odrl:target :Observacao_Geolocalizacao_Apiario ;
        odrl:assignee :Importador_Alemao_Mel ;
        rdfs:comment "Dados de geolocalização não podem ser revendidos."@pt
    ] .

:DataContract_Pesquisa_Meliponideos
    a agritrust:DataContract ;
    agritrust:contractId "CONTRACT-RESEARCH-MN-2026-015" ;
    rdfs:label "Contrato de Dados - Pesquisa Científica Meliponídeos"@pt ;
    agritrust:validFrom "2026-04-20T00:00:00Z"^^xsd:dateTime ;
    agritrust:validUntil "2028-04-20T00:00:00Z"^^xsd:dateTime ;
    :priceUnits 1000000 ;  # ilustrativo: 1,00 USDT de teste (6 casas); valores de exemplo do mel-trust, não definidos pelo Ivan
    agritrust:purpose "Estudo Científico de Caracterização de Méis Nativos do Cerrado"@pt ;
    agritrust:hasPolicyAssignee :Universidade_Brasilia ;
    agritrust:coversAsset :Lote_Mel_Jatai_2026_015 ;
    agritrust:coversObservation :Observacao_Quantidade_Jatai, :Observacao_Qualidade_Jatai ;
    agritrust:hasODRLPolicy :Politica_Acesso_Pesquisa_Nativo .

:Politica_Acesso_Pesquisa_Nativo
    a odrl:Set ;
    odrl:permission [
        a odrl:Permission ;
        odrl:action odrl:read ;
        odrl:target :Lote_Mel_Jatai_2026_015 ;
        odrl:assignee :Universidade_Brasilia ;
        odrl:constraint [
            a odrl:Constraint ;
            odrl:leftOperand odrl:purpose ;
            odrl:operator odrl:eq ;
            odrl:rightOperand "Pesquisa Científica"@pt
        ]
    ] ;
    odrl:permission [
        a odrl:Permission ;
        odrl:action odrl:aggregate ;
        odrl:target :Lote_Mel_Jatai_2026_015 ;
        odrl:assignee :Universidade_Brasilia ;
        rdfs:comment "Permitido agregar dados anonimizados para publicação científica."@pt
    ] ;
    odrl:prohibition [
        a odrl:Prohibition ;
        odrl:action odrl:attribute ;
        odrl:target :Lote_Mel_Jatai_2026_015 ;
        odrl:assignee :Universidade_Brasilia ;
        rdfs:comment "Dados não podem ser atribuídos nominalmente ao apicultor sem consentimento adicional."@pt
    ] .

