# Observações de Campo (com Evidência de Captura Hands-Free)

:Observacao_Quantidade_Silvestre
    a sosa:Observation ;
    sosa:observedProperty "Volume de Mel Colhido"@pt ;
    sosa:hasSimpleResult "15.0"^^xsd:decimal ;
    sosa:hasUnit qudt:L ;
    :hasAudioSource <https://data.agritrust.org/audio/whatsapp_15042026_001.ogg> ;
    :hasImageSource <https://data.agritrust.org/images/whatsapp_15042026_001.jpg> ;
    :imageCaptureMethod "Timer 10s"@pt ;
    :transcriptionText "Apiário Cerrado Vivo. Colhi quinze litros de mel silvestre da aroeira hoje de manhã. Tava bem maduro."@pt ;
    :confidenceScore "0.94"^^xsd:decimal ;
    sosa:resultTime "2026-04-15T14:45:00Z"^^xsd:dateTime .

:Observacao_Florada_Silvestre
    a sosa:Observation ;
    sosa:observedProperty "Origem Floral"@pt ;
    sosa:hasSimpleResult "Aroeira"@pt ;
    :hasAudioSource <https://data.agritrust.org/audio/whatsapp_15042026_001.ogg> ;
    :transcriptionText "mel silvestre da aroeira"@pt ;
    :confidenceScore "0.89"^^xsd:decimal .

:Observacao_Quantidade_Jatai
    a sosa:Observation ;
    sosa:observedProperty "Volume de Mel Nativo Colhido"@pt ;
    sosa:hasSimpleResult "1.8"^^xsd:decimal ;
    sosa:hasUnit qudt:L ;
    :hasAudioSource <https://data.agritrust.org/audio/whatsapp_16042026_002.ogg> ;
    :hasImageSource <https://data.agritrust.org/images/whatsapp_16042026_002.jpg> ;
    :imageCaptureMethod "Botão Volume"@pt ;
    :transcriptionText "Bom dia. Hoje colhi o mel das jataí. Deu um litro e oitocentos das duas caixinhas. Tá bem cheiroso."@pt ;
    :confidenceScore "0.91"^^xsd:decimal ;
    sosa:resultTime "2026-04-16T11:20:00Z"^^xsd:dateTime .

:Observacao_Qualidade_Jatai
    a sosa:Observation ;
    sosa:observedProperty "Características Organolépticas"@pt ;
    sosa:hasSimpleResult "Mel bastante líquido, aroma intenso característico de Jataí, coloração âmbar clara."@pt ;
    :hasAudioSource <https://data.agritrust.org/audio/whatsapp_16042026_002.ogg> ;
    :transcriptionText "Tá bem cheiroso, bem líquido também, do jeito que o povo gosta."@pt ;
    :confidenceScore "0.87"^^xsd:decimal .

:Observacao_Saude_Colmeias
    a sosa:Observation ;
    sosa:observedProperty "Status Sanitário"@pt ;
    sosa:hasSimpleResult "Todas as colmeias com boa postura, sem sinais de doenças. Presença de pólen nas entradas."@pt ;
    :hasAudioSource <https://data.agritrust.org/audio/whatsapp_10042026_004.ogg> ;
    :transcriptionText "Revisão das colmeias hoje. Tudo tranquilo, bastante cria, sem doença. As apis tão trazendo muito pólen."@pt ;
    :confidenceScore "0.90"^^xsd:decimal .

:Observacao_Geolocalizacao_Apiario
    a sosa:Observation ;
    sosa:observedProperty "Geolocalização e Conformidade Ambiental"@pt ;
    sosa:hasResult :Apiario_CerradoVivo_Geo_Poligono ;
