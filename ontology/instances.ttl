# 4.1 Portaria SDA/MAPA nº 795/2023 (Base Legal Principal)

:Portaria_795_2023
    a agritrust:QualityStandard, owl:NamedIndividual ;
    rdfs:label "Portaria SDA/MAPA nº 795/2023"@pt ;
    rdfs:seeAlso <https://www.in.gov.br/web/dou/-/portaria-sda-n-795-de-10-de-maio-de-2023-483073181> ;
    dc:source "Brasil. Ministério da Agricultura e Pecuária. Secretaria de Defesa Agropecuária. Portaria SDA nº 795, de 10 de maio de 2023." ;
    dc:date "2023-05-10"^^xsd:date ;
    rdfs:comment """
        Define as normas higiênico-sanitárias e tecnológicas para os estabelecimentos 
        que elaborem produtos de abelhas e seus derivados.
        Classifica produtos de abelhas do gênero Apis e da tribo Meliponini.
        Estabelece requisitos para extração, beneficiamento, rotulagem, transporte e rastreabilidade.
        """@pt .

# 4.2 Portaria SDA/MAPA nº 1.439/2025 (Atualização)

:Portaria_1439_2025
    a agritrust:QualityStandard, owl:NamedIndividual ;
    rdfs:label "Portaria SDA/MAPA nº 1.439/2025"@pt ;
    rdfs:seeAlso <https://www.gov.br/agricultura/pt-br/assuntos/inspecao/produtos-animal/legislacao/copy2_of_Port7952023normaprodutosabelhas.pdf> ;
    dc:source "Brasil. Ministério da Agricultura e Pecuária. Secretaria de Defesa Agropecuária. Portaria SDA nº 1.439, de 6 de novembro de 2025." ;
    dc:date "2025-11-06"^^xsd:date ;
    rdfs:comment """
        Altera a Portaria SDA/MAPA nº 795/2023.
        Principais alterações:
        - Inclui definição de 'escoamento' como método de coleta para mel de abelhas sem ferrão (Art. 2º, XXV)
        - Atualiza definição de tratamento térmico (pasteurização, fusão rápida, descristalização)
        - Inclui 'desumidificação ou desidratação' como etapa facultativa (Art. 2º, XIV)
        - Atualiza critérios de destinação no Anexo:
          * Mel nativo: Umidade até 23% → Aproveitamento Condicional
          * Mel nativo: Acidez até 80 mEq/kg → Destinação Industrial
          * Mel com HMF acima do padrão → Destinação Industrial (se diástase conforme)
        """@pt .

# 4.3 Instrução Normativa nº 11/2000 (RTIQ do Mel - Apis mellifera)

:Standard_IN11_Apis
    a agritrust:QualityStandard, owl:NamedIndividual ;
    rdfs:label "IN 11/2000 - Regulamento Técnico de Identidade e Qualidade do Mel (Apis mellifera)"@pt ;
    rdfs:seeAlso <https://www.gov.br/agricultura/pt-br/assuntos/inspecao/produtos-animal/legislacao/IN112000RTmel.pdf> ;
    dc:source "Brasil. Ministério da Agricultura, Pecuária e Abastecimento. Instrução Normativa nº 11, de 20 de outubro de 2000." ;
    dc:date "2000-10-20"^^xsd:date ;
    rdfs:comment """
        Aprova o Regulamento Técnico de Identidade e Qualidade do Mel.
        Aplicável exclusivamente ao mel de Apis mellifera.
        """@pt ;
    :definesMaximum [
        a agritrust:Threshold ;
        agritrust:observedProperty "Umidade"@pt ;
        agritrust:hasMaximumValue "20.0"^^xsd:decimal ;
        agritrust:hasUnit qudt:PERCENT ;
        rdfs:comment "Acima de 20% indica risco de fermentação para mel de Apis mellifera."@pt
    ] ;
    :definesMaximum [
        a agritrust:Threshold ;
        agritrust:observedProperty "HMF"@pt ;
        agritrust:hasMaximumValue "60.0"^^xsd:decimal ;
        agritrust:hasUnit qudt:MilliGM-PER-KiloGM ;
        rdfs:comment "Hidroximetilfurfural - máximo 60 mg/kg."@pt
    ] ;
    :definesMaximum [
        a agritrust:Threshold ;
        agritrust:observedProperty "Acidez"@pt ;
        agritrust:hasMaximumValue "50.0"^^xsd:decimal ;
        agritrust:hasUnit <http://qudt.org/vocab/unit/MilliEQ-PER-KiloGM> ;
        rdfs:comment "Acidez livre - máximo 50 meq/kg."@pt
    ] ;
    :definesMinimum [
        a agritrust:Threshold ;
        agritrust:observedProperty "Atividade Diastásica"@pt ;
        agritrust:hasMinimumValue "8.0"^^xsd:decimal ;
        agritrust:hasUnit <http://qudt.org/vocab/unit/GOTHE> ;
        rdfs:comment "Mínimo 8 na escala Gothe (exceto méis naturalmente pobres em enzimas)."@pt
    ] ;
    :definesMinimum [
        a agritrust:Threshold ;
        agritrust:observedProperty "Açúcares Redutores"@pt ;
        agritrust:hasMinimumValue "65.0"^^xsd:decimal ;
        agritrust:hasUnit qudt:PERCENT ;
        rdfs:comment "Mínimo 65 g/100g para mel floral."@pt
    ] ;
    :definesMaximum [
        a agritrust:Threshold ;
        agritrust:observedProperty "Sacarose Aparente"@pt ;
        agritrust:hasMaximumValue "6.0"^^xsd:decimal ;
        agritrust:hasUnit qudt:PERCENT ;
        rdfs:comment "Máximo 6 g/100g (exceto méis específicos)."@pt
    ] ;
    :definesMaximum [
        a agritrust:Threshold ;
        agritrust:observedProperty "Cinzas"@pt ;
        agritrust:hasMaximumValue "0.6"^^xsd:decimal ;
        agritrust:hasUnit qudt:PERCENT ;
        rdfs:comment "Máximo 0,6 g/100g para mel floral."@pt
    ] ;
    :definesMinimum [
        a agritrust:Threshold ;
        agritrust:observedProperty "Sólidos Insolúveis em Água"@pt ;
        agritrust:hasMaximumValue "0.1"^^xsd:decimal ;
        agritrust:hasUnit qudt:PERCENT ;
        rdfs:comment "Máximo 0,1 g/100g para mel prensado."@pt
    ] .

# 4.4 Referência Científica: Vale et al., 2018 (Meliponídeos no Acre)

:ScientificReference_Vale_2018
    a agritrust:ScientificPublication, owl:NamedIndividual ;
    rdfs:label "Vale et al., 2018. Honey quality of Melipona sp. in Acre, Brazil."@en ;
    dc:bibliographicCitation """
        Vale, M. A. D.; Gomes, F. A.; Santos, B. R. C.; Ferreira, J. B. 
        Honey quality of Melipona sp. bees in Acre, Brazil. 
        Acta Agronómica, v. 67, n. 2, p. 201-207, 2018.
        """ ;
    dc:identifier <https://doi.org/10.15446/acag.v67n2.60836> ;
    rdfs:comment """
        Conclui que a legislação brasileira (IN 11/2000) é inadequada para abelhas 
        nativas, principalmente quanto aos parâmetros de umidade e acidez. 
        Recomenda o estabelecimento de padrões específicos para meliponídeos.
        """@pt ;
    :keyFindings """
        - Umidade variou de 23,5% a 31,2% entre espécies de Melipona
        - Acidez variou de 34,7 a 78,3 meq/kg
        - 100% das amostras seriam reprovadas pela IN 11/2000 no parâmetro umidade
        - HMF geralmente baixo (<10 mg/kg) quando fresco
        - Açúcares redutores: 58,3% a 72,1%
        """@pt .

# 4.5 Referência Científica: Sousa et al., 2009 (Meliponídeos no Nordeste)

:ScientificReference_Sousa_2009
    a agritrust:ScientificPublication, owl:NamedIndividual ;
    rdfs:label "Sousa et al., 2009. Characterization of honey produced by species of Melipona Illiger."@en ;
    dc:bibliographicCitation """
        Sousa, B. A.; Marchini, L. C.; Oda-Souza, M.; Carvalho, C. A. L.; Alves, R. M. O. 
        Characterization of honey produced by species of Melipona Illiger, 1806 
        (apidae: meliponini) from the northeast area of Brazil: 1. Physico-chemical characteristics. 
        Química Nova, v. 32, n. 2, p. 303-308, 2009.
        """ ;
    dc:identifier <https://doi.org/10.1590/S0100-40422009000200007> ;
    rdfs:comment """
        Caracterização físico-química de méis de diferentes espécies de Melipona 
        no Nordeste do Brasil. Evidencia a variabilidade interespecífica e a 
        necessidade de padrões diferenciados.
        """@pt ;
    :keyFindings """
        - Umidade: 23,1% a 30,5% (dependendo da espécie)
        - Acidez: 28,7 a 79,5 meq/kg
        - HMF: geralmente baixo (< 10 mg/kg) quando fresco
        - Cinzas: 0,12% a 0,45%
        - Açúcares redutores: 58,3% a 72,1%
        """@pt .

# 4.6 Referência Científica: Braga et al., 2020 (Melipona subnitida)

:ScientificReference_Braga_2020
    a agritrust:ScientificPublication, owl:NamedIndividual ;
    rdfs:label "Braga et al., 2020. Analytical study of physicochemical characteristics from Melipona subnitida honey."@en ;
    dc:bibliographicCitation """
        Braga, D. C.; Liberato, M. C. T. C.; Lima, V. L. F.; Araújo-Neto, J. A. M. 
        Analytical study of the physicochemical characteristics from Melipona subnitida D. 
        honey in adequation to Brazilian law. 
        Food Science and Technology, v. 40, suppl 1, p. 217-221, 2020.
        """ ;
    dc:identifier <https://doi.org/10.1590/fst.08919> ;
    rdfs:comment """
        Análise da adequação do mel de Jandaíra (Melipona subnitida) à legislação 
        brasileira. Conclui pela inadequação dos parâmetros atuais.
        """@pt ;
    :keyFindings """
        - Umidade média: 26,3% (acima do limite de 20% da IN 11)
        - Acidez média: 44,3 meq/kg
        - 100% de desconformidade no parâmetro umidade
        - Recomenda regulamentação específica para mel de abelhas nativas
        """@pt .


